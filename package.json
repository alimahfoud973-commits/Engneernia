{
  "name": "engineering-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:prove-rls": "psql -v ON_ERROR_STOP=1 -f src/db/security/rls-foundation.test.sql",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bootstrap:owner": "node --experimental-strip-types scripts/bootstrap-owner.ts",
    "seed:catalog": "node --experimental-strip-types scripts/seed-catalog.ts",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "db:dev": "bash scripts/dev-db.sh",
    "seed:demo-media": "node --experimental-strip-types --conditions=react-server --import ./scripts/with-alias.mjs scripts/seed-demo-media.ts",
    "seed:scale": "node --experimental-strip-types scripts/seed-scale.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@napi-rs/canvas": "^1.0.9",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "mupdf": "^1.28.1",
    "next": "^16.3.5",
    "next-intl": "^4.14.4",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "fast-check": "^4.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
