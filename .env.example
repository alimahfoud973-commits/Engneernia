# ---------------------------------------------------------------------------
# Engineering Marketplace — environment template
# Copy to .env.local for development. NEVER commit a filled-in copy.
# Every variable here is validated at boot by src/lib/config/env.ts —
# a missing or malformed value fails fast instead of failing at runtime.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
#
# NODE_ENV IS DELIBERATELY ABSENT. Next.js sets it itself — `development` for
# `next dev`, `production` for `next build` — and Vitest sets `test`. Putting
# it in this file achieves nothing when Next reads the file, and breaks the
# BUILD when a shell sources the file before running it: `next build` then
# honours NODE_ENV=development, warns that the value is non-standard, and
# prerendering /_global-error dies with a null React dispatcher.
#
# That was KI-1, and it cost two phases of misdiagnosis. Do not add it back.
APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# The APPLICATION connects as a restricted, non-superuser role so that
# PostgreSQL Row-Level Security is a real boundary and not a decoration.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/engineering_marketplace
# Migrations run as a separate, more privileged role.
DATABASE_MIGRATION_URL=postgresql://migrator:migrator_password@localhost:5432/engineering_marketplace
# TESTS ONLY. Used by the integration suite to prove that the audit log's
# append-only trigger stops even a session that bypasses Row-Level Security.
# Never set this in a production environment.
DATABASE_SUPERUSER_URL=postgresql://postgres:postgres@localhost:5432/engineering_marketplace

# --- Sessions / crypto ----------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-bytes-of-base64-randomness
# Encrypts payment-provider credentials at rest (settings table).
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=replace-me-with-32-bytes-of-base64-randomness

# --- Private object storage (S3-compatible: MinIO locally, R2 in production) --
# There is NO public bucket. Both buckets are private; access is always
# via short-lived signed URLs issued after a server-side authorization check.
# file://<path> selects the filesystem adapter for local work.
# Production requires a real S3-compatible endpoint; the app refuses to boot otherwise.
STORAGE_ENDPOINT=file:///home/user/engineering-marketplace/.data/storage
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_ORIGINALS=engineering-originals
STORAGE_BUCKET_DERIVATIVES=engineering-derivatives
STORAGE_FORCE_PATH_STYLE=true

# --- Outbound email -------------------------------------------------------
# Decision OPEN-23: customers register themselves and must confirm the
# address before they can buy, so mail delivery is on the critical path.
#
# One URL selects the adapter, exactly like STORAGE_ENDPOINT:
#   log://           write the message to the log instead of sending it.
#                    The verification link appears in the server output.
#                    REFUSED IN PRODUCTION, at boot and again at send time.
#   smtp://user:pass@host:587    STARTTLS
#   smtps://user:pass@host:465   implicit TLS
# Percent-encode any ':' '@' or '/' in the password.
MAIL_TRANSPORT_URL=log://local
# Quoted: the angle brackets are shell metacharacters, and this file is
# sourced directly by some of the deployment steps in docs/DEPLOYMENT.md.
MAIL_FROM="Enginora <no-reply@localhost>"

# --- Accounting -----------------------------------------------------------
# Decision D-08: all period boundaries, sale dates, reports and settlements
# are computed in this timezone. Changing it changes accounting history
# boundaries — treat as a migration, not a setting.
PLATFORM_TIMEZONE=Asia/Damascus
# Decision D-04: base accounting currency. Additional currencies are added
# as data, not code.
PLATFORM_BASE_CURRENCY=USD

# --- Localisation ---------------------------------------------------------
# Decision D-03: Arabic is the primary locale in phase 1; English is added
# later as data + message catalogue, with no UI rebuild.
DEFAULT_LOCALE=ar

# Specification §26: five pages. A policy, not a constant.
PREVIEW_PAGE_COUNT=5

# Explicit choice: 'none' or 'clamav'. Running without scanning must be
# a decision recorded in configuration, not an unnoticed default.
MALWARE_SCANNER=none

# --- SEO -------------------------------------------------------------------
# May search engines index this deployment? Default false.
# Set to true ONLY on the real production domain, at launch. A staging copy
# that forgets this stays out of the index; a production one that forgets it is
# merely invisible until noticed — the cheaper mistake of the two.
# The private areas (/admin, /account, /checkout, /login, /api) are refused to
# crawlers regardless of this value.
SEO_INDEXABLE=false
