# Production values for docker-compose.prod.yml.
#   cp .env.production.example .env.production   — and never commit the result.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"

APP_URL=https://enginora.com

POSTGRES_SUPERUSER_PASSWORD=

# app_user — the application role. NOT postgres, NOT migrator.
DATABASE_URL=postgresql://app_user:CHANGE_ME@postgres:5432/engineering_marketplace
# migrator — owns the schema, used only by `npm run db:migrate`.
DATABASE_MIGRATION_URL=postgresql://migrator:CHANGE_ME@postgres:5432/engineering_marketplace

SESSION_SECRET=
CONFIG_ENCRYPTION_KEY=

# S3-compatible storage. Cloudflare R2, Backblaze B2, MinIO on another host —
# anything with an S3 API. A file:// path is refused in production.
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_ORIGINALS=em-originals
STORAGE_BUCKET_DERIVATIVES=em-derivatives

# Registration verification mail. 'log://' is refused here — the process will
# not start with it, because sign-ups would silently go nowhere.
MAIL_TRANSPORT_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Enginora <no-reply@enginora.com>"

PLATFORM_TIMEZONE=Asia/Damascus
PLATFORM_BASE_CURRENCY=USD

# 'none' must be a recorded decision, not an unnoticed default.
MALWARE_SCANNER=none

# Turn on LAST, once the site is live on the real domain.
SEO_INDEXABLE=false
